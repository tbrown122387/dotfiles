" ---------------------------------------------------------------------------
" General
" ---------------------------------------------------------------------------
set nocompatible
filetype plugin indent on
syntax on

set encoding=utf-8
set backspace=indent,eol,start
set hidden                     " allow switching buffers without saving
set mouse=a                    " mouse support in all modes
set clipboard^=unnamed,unnamedplus  " use system clipboard where available
set updatetime=300
set signcolumn=yes

" Keep swap/backup/undo files out of the working directory
set directory=~/.vim/swap//
set backupdir=~/.vim/backup//
set undodir=~/.vim/undo//
set undofile
for d in [&directory, &backupdir, &undodir]
  if !isdirectory(d)
    call mkdir(d, 'p', 0700)
  endif
endfor

" ---------------------------------------------------------------------------
" UI
" ---------------------------------------------------------------------------
set number relativenumber
set ruler
set showcmd
set wildmenu
set laststatus=2
set scrolloff=5
set cursorline
set termguicolors
colorscheme desert

" ---------------------------------------------------------------------------
" Indentation
" ---------------------------------------------------------------------------
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set autoindent
set smartindent

" ---------------------------------------------------------------------------
" Search
" ---------------------------------------------------------------------------
set incsearch
set hlsearch
set ignorecase
set smartcase

" ---------------------------------------------------------------------------
" Splits
" ---------------------------------------------------------------------------
set splitright
set splitbelow

" ---------------------------------------------------------------------------
" Keymaps
" ---------------------------------------------------------------------------
let mapleader = ","

" Clear search highlight
nnoremap <leader><space> :nohlsearch<CR>

" Move between splits with Ctrl+hjkl
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Quick save/quit
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>

" ---------------------------------------------------------------------------
" clang-tidy
" ---------------------------------------------------------------------------
function! RunClangTidy()
  let l:file = expand('%:p')
  if empty(l:file)
    echo 'No file to run clang-tidy on'
    return
  endif
  let l:db = findfile('compile_commands.json', expand('%:p:h') . ';')
  let l:cmd = 'clang-tidy ' . shellescape(l:file)
  if !empty(l:db)
    let l:cmd .= ' -p ' . shellescape(fnamemodify(l:db, ':h'))
  else
    let l:cmd .= ' --'
  endif
  let &makeprg = l:cmd
  silent make!
  botright cwindow
  redraw!
endfunction

command! ClangTidy call RunClangTidy()
nnoremap <leader>ct :ClangTidy<CR>

" ---------------------------------------------------------------------------
" clang-format
" ---------------------------------------------------------------------------
function! RunClangFormat()
  let l:bin = executable('clang-format') ? 'clang-format' : 'clang-format-21'
  if !executable(l:bin)
    echo 'clang-format not found in PATH'
    return
  endif
  let l:winview = winsaveview()
  execute 'silent %!' . l:bin . ' --assume-filename=' . shellescape(expand('%'))
  if v:shell_error
    undo
    echo 'clang-format failed, buffer left unchanged'
  endif
  call winrestview(l:winview)
endfunction

command! ClangFormat call RunClangFormat()
nnoremap <leader>cf :ClangFormat<CR>
